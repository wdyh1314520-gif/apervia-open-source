APP_IMAGE=ghcr.io/wdyh1314520-gif/apervia-open-source:latest
APP_PULL_POLICY=always
APP_BIND_IP=127.0.0.1
TRUST_PROXY_X_FOR=0
APP_HOST_PORT=8002
AUTH_SIGNUP_ENABLED=1
AUTH_DEFAULT_ROLE=pending
AUTH_SESSION_MAX_AGE_S=2592000
AUTH_PASSWORD_ITERATIONS=600000
TZ=Asia/Shanghai
SANDBOX_TOOLS_ENABLED=0
SANDBOX_DOCKER_IMAGE=ghcr.io/wdyh1314520-gif/apervia-open-source-sandbox:latest
# On Linux, use the result of `stat -c %g /var/run/docker.sock`; Docker Desktop usually uses 0.
DOCKER_SOCKET_GID=0
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
SANDBOX_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
APT_MIRROR=
# Optional: when empty, the key is generated in /data and included in volume backups. If set, keep the same secure value outside the repository.
APP3_MCP_TOKEN_KEY=
SANDBOX_RUNNER_SECRET=
